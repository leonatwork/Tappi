/* Tappi — es. Keys must exist in every language: scripts/check-localizations.swift */

/* Menu status line: Tappi cannot run because Accessibility is not granted. */
"status.inactive" = "Inactivo · Falta el permiso de Accesibilidad";

/* Menu status line: running, but no windows could be read. */
"status.noWindows" = "No se detectan ventanas · Revisa los permisos";

/* Menu status line with exactly one window. %1$@ = modifier symbol (e.g. ⌘), %2$ld = window count, %3$@ = optional suffix (status.withoutPreviews). */
"status.active.one" = "Activo · %1$@Tab · %2$ld ventana%3$@";

/* Menu status line with any other number of windows. Same arguments as status.active.one. */
"status.active.other" = "Activo · %1$@Tab · %2$ld ventanas%3$@";

/* Appended to the status line when previews are on but Screen Recording is missing. Keep the leading space. */
"status.withoutPreviews" = " · sin vistas previas";

/* Menu item that opens the Accessibility list in System Settings. Use Apple's name for the pane. */
"menu.grantAccessibility" = "Conceder permiso de Accesibilidad…";

/* Submenu title for the interface language. */
"menu.language" = "Idioma";

/* Language submenu entry that follows the macOS preferred languages. */
"language.system" = "Predeterminado del sistema";

/* Submenu title: which modifier key is held down while switching. */
"menu.modifier" = "Tecla modificadora";

/* Name of the Option key, with its PC equivalent in parentheses. */
"modifier.option" = "Opción (Alt)";

/* Name of the Command key. */
"modifier.command" = "Comando";

/* Name of the Control key. */
"modifier.control" = "Control";

/* Submenu title: how long to wait before the switcher panel is drawn. */
"menu.showDelay" = "Retardo de aparición";

/* Show delay of 0 ms. */
"delay.instant" = "Inmediato (como en Windows)";

/* Submenu title: size of one window tile in the switcher. */
"menu.tileSize" = "Tamaño de los mosaicos";

/* Submenu title: maximum number of tiles per row. */
"menu.tilesPerRow" = "Mosaicos por fila";

/* Panel screen submenu and its three choices. Active uses the focused window. */
"menu.panelScreen" = "Pantalla del panel";
"panelScreen.active" = "Pantalla activa";
"panelScreen.mouse" = "Bajo el puntero del ratón";
"panelScreen.main" = "Pantalla principal";

/* Toggle: disable the macOS app switcher while Tappi owns ⌘Tab. */
"menu.replaceSystemSwitcher" = "Reemplazar ⌘Tab del sistema";

/* Tooltip on the disabled toggle above. */
"tooltip.replaceSystemSwitcher" = "Solo se aplica si la tecla modificadora es ⌘.";

/* Menu item that hands ⌘Tab back to macOS. */
"menu.restoreSystemSwitcher" = "Restaurar ⌘Tab del sistema";

/* Toggle: live window thumbnails in the switcher. */
"menu.windowPreviews" = "Vistas previas de ventanas";

/* Menu item that requests Screen Recording. Use Apple's name for the pane. Also quoted in a diagnostics message. */
"menu.grantScreenRecording" = "Conceder permiso de Grabación de pantalla…";

/* Tooltip on the item above. */
"tooltip.grantScreenRecording" = "Sin este permiso, Tappi muestra los iconos de las apps en lugar de las vistas previas de las ventanas.";

/* Menu item: Screen Recording only takes effect after a restart. */
"menu.restartForPreviews" = "Reiniciar para activar las vistas previas";

/* Toggle: list minimized windows. */
"menu.minimizedWindows" = "Ventanas minimizadas";

/* Toggle: list windows on other Spaces (Mission Control desktops). Use Apple's term for Spaces. */
"menu.otherSpaces" = "Ventanas de otros espacios";

/* Toggle: list windows of apps hidden with ⌘H. */
"menu.hiddenApps" = "Ventanas de apps ocultas";

/* Toggle: hovering a tile selects it. */
"menu.mouseHover" = "La selección sigue al ratón";

/* Toggle: start Tappi at login. */
"menu.launchAtLogin" = "Abrir al iniciar sesión";

/* Menu item that opens settings.json in a text editor. */
"menu.openSettingsFile" = "Abrir el archivo de ajustes";

/* Menu item that opens diagnostics.log. */
"menu.openDiagnostics" = "Abrir el registro de diagnóstico";

/* Menu item. */
"menu.restart" = "Reiniciar Tappi";

/* Menu item. */
"menu.quit" = "Salir de Tappi";

/* Submenu title listing the other tools of the same package. */
"menu.moreApps" = "Más apps que te pueden gustar";

/* Short description after “Klemmi – ” in the More apps submenu. */
"moreApps.klemmi" = "Historial del portapapeles como Win+V";

/* Short description after “Snapline – ” in the More apps submenu. Snap Layouts, Aero Snap and Snap Assist are Windows feature names. */
"moreApps.snapline" = "Snap Layouts, Aero Snap y Snap Assist";

/* Short description after “Snapboard – ” in the More apps submenu. */
"moreApps.snapboard" = "Capturas al estilo Snipping Tool, directo al portapapeles";

/* Last entry of the More apps submenu: opens the list of all tools in the package. */
"moreApps.package" = "El paquete completo…";

/* Diagnostics log line. Use Apple's names for System Settings, Privacy & Security and Accessibility. */
"diagnostics.eventTapRefused" = "Accesibilidad figura como concedida, pero se rechazó la captura de teclado — elimina Tappi en Ajustes del Sistema ▸ Privacidad y seguridad ▸ Accesibilidad y vuelve a añadirlo (una nueva compilación invalida la entrada anterior)";

/* Diagnostics log line. %@ = the menu item menu.grantScreenRecording. */
"diagnostics.screenRecordingDenied" = "Grabación de pantalla denegada — se muestran iconos de apps en lugar de vistas previas; concédela desde el icono de la barra de menús ▸ «%@»";
